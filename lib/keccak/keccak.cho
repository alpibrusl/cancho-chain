edition 7;

module chain.keccak;

// Keccak-256 as Ethereum uses it: the original Keccak padding (0x01 ... 0x80), not the SHA-3 standard's (0x06 ... 0x80).
// docs/design.md section 4.
//
// A lane is 64 bits and `int` is signed, so a lane is two words, `lo` and `hi`, each held in [0, 2^32) (the way std.crc keeps a CRC-64).
// Every shift below is therefore of a value under 2^32 by at most 31, which stays under 2^63, and every `>>` is logical for free.
//
// The caller provides the working space (`state_len()` words), as std.ecdsa_sign does: nothing here allocates.
//   st[0..50]    the state A, lane i at st[2i] (lo) and st[2i+1] (hi)
//   st[50..100]  the permuted copy B
//   st[100..110] the column parities C

pub fn state_len() -> [] int {
    return 110;
}

pub fn digest_len() -> [] int {
    return 32;
}

pub fn ok() -> [] int {
    return 0;
}

// the digest buffer is not 32 bytes
pub fn refused_output_length() -> [] int {
    return -90;
}

// the working space is shorter than state_len()
pub fn refused_state_length() -> [] int {
    return -91;
}

pub fn refusal_tag(code: int) -> [] &static [byte] {
    if code == -90 {
        return "keccak-output-length";
    }
    if code == -91 {
        return "keccak-state-length";
    }
    return "keccak-unknown";
}

static round_lo: [int] {
    let t = alloc_slice[static](24, 0);
    t[0] = 0x00000001; t[1] = 0x00008082; t[2] = 0x0000808a; t[3] = 0x80008000;
    t[4] = 0x0000808b; t[5] = 0x80000001; t[6] = 0x80008081; t[7] = 0x00008009;
    t[8] = 0x0000008a; t[9] = 0x00000088; t[10] = 0x80008009; t[11] = 0x8000000a;
    t[12] = 0x8000808b; t[13] = 0x0000008b; t[14] = 0x00008089; t[15] = 0x00008003;
    t[16] = 0x00008002; t[17] = 0x00000080; t[18] = 0x0000800a; t[19] = 0x8000000a;
    t[20] = 0x80008081; t[21] = 0x00008080; t[22] = 0x80000001; t[23] = 0x80008008;
    return t;
}

static round_hi: [int] {
    let t = alloc_slice[static](24, 0);
    t[0] = 0x00000000; t[1] = 0x00000000; t[2] = 0x80000000; t[3] = 0x80000000;
    t[4] = 0x00000000; t[5] = 0x00000000; t[6] = 0x80000000; t[7] = 0x80000000;
    t[8] = 0x00000000; t[9] = 0x00000000; t[10] = 0x00000000; t[11] = 0x00000000;
    t[12] = 0x00000000; t[13] = 0x80000000; t[14] = 0x80000000; t[15] = 0x80000000;
    t[16] = 0x80000000; t[17] = 0x80000000; t[18] = 0x00000000; t[19] = 0x80000000;
    t[20] = 0x80000000; t[21] = 0x80000000; t[22] = 0x00000000; t[23] = 0x80000000;
    return t;
}

// rotation offsets, indexed x + 5y
static rho: [int] {
    let t = alloc_slice[static](25, 0);
    t[0] = 0; t[1] = 1; t[2] = 62; t[3] = 28; t[4] = 27;
    t[5] = 36; t[6] = 44; t[7] = 6; t[8] = 55; t[9] = 20;
    t[10] = 3; t[11] = 10; t[12] = 43; t[13] = 25; t[14] = 39;
    t[15] = 41; t[16] = 45; t[17] = 15; t[18] = 21; t[19] = 8;
    t[20] = 18; t[21] = 2; t[22] = 61; t[23] = 56; t[24] = 14;
    return t;
}

// the low word of the 64-bit lane (hi, lo) rotated left by n, 0 <= n < 64
fn rotl_lo(hi: int, lo: int, n: int) -> [] int {
    var h = hi;
    var l = lo;
    var k = n;
    if k >= 32 {
        h = lo;
        l = hi;
        k = k - 32;
    }
    if k == 0 {
        return l;
    }
    return (l << k | h >> (32 - k)) & 0xffffffff;
}

// the high word of the same
fn rotl_hi(hi: int, lo: int, n: int) -> [] int {
    var h = hi;
    var l = lo;
    var k = n;
    if k >= 32 {
        h = lo;
        l = hi;
        k = k - 32;
    }
    if k == 0 {
        return h;
    }
    return (h << k | l >> (32 - k)) & 0xffffffff;
}

fn permute[&s](st: &!s [int]) -> [] int {
    var round = 0;
    while round < 24 {
        // theta
        var x = 0;
        while x < 5 {
            st[100 + 2 * x] = st[2 * x] ^ st[2 * (x + 5)] ^ st[2 * (x + 10)] ^ st[2 * (x + 15)] ^ st[2 * (x + 20)];
            st[101 + 2 * x] = st[2 * x + 1] ^ st[2 * (x + 5) + 1] ^ st[2 * (x + 10) + 1] ^ st[2 * (x + 15) + 1] ^ st[2 * (x + 20) + 1];
            x = x + 1;
        }
        x = 0;
        while x < 5 {
            let left = (x + 4) % 5;
            let right = (x + 1) % 5;
            let dlo = st[100 + 2 * left] ^ rotl_lo(st[101 + 2 * right], st[100 + 2 * right], 1);
            let dhi = st[101 + 2 * left] ^ rotl_hi(st[101 + 2 * right], st[100 + 2 * right], 1);
            var y = 0;
            while y < 5 {
                st[2 * (x + 5 * y)] = st[2 * (x + 5 * y)] ^ dlo;
                st[2 * (x + 5 * y) + 1] = st[2 * (x + 5 * y) + 1] ^ dhi;
                y = y + 1;
            }
            x = x + 1;
        }
        // rho and pi: B[y + 5((2x + 3y) mod 5)] = rotl(A[x + 5y], rho[x + 5y])
        x = 0;
        while x < 5 {
            var y = 0;
            while y < 5 {
                let src = x + 5 * y;
                let dst = y + 5 * ((2 * x + 3 * y) % 5);
                let hi = st[2 * src + 1];
                let lo = st[2 * src];
                st[50 + 2 * dst] = rotl_lo(hi, lo, rho[src]);
                st[51 + 2 * dst] = rotl_hi(hi, lo, rho[src]);
                y = y + 1;
            }
            x = x + 1;
        }
        // chi
        var y = 0;
        while y < 5 {
            x = 0;
            while x < 5 {
                let a = x + 5 * y;
                let b = (x + 1) % 5 + 5 * y;
                let c = (x + 2) % 5 + 5 * y;
                st[2 * a] = st[50 + 2 * a] ^ ((st[50 + 2 * b] ^ 0xffffffff) & st[50 + 2 * c]);
                st[2 * a + 1] = st[51 + 2 * a] ^ ((st[51 + 2 * b] ^ 0xffffffff) & st[51 + 2 * c]);
                x = x + 1;
            }
            y = y + 1;
        }
        // iota
        st[0] = st[0] ^ round_lo[round];
        st[1] = st[1] ^ round_hi[round];
        round = round + 1;
    }
    return 0;
}

// XOR the byte `v` into byte position `pos` (0..199) of the state, little-endian within a lane
fn xor_byte[&s](st: &!s [int], pos: int, v: int) -> [] int {
    let lane = pos / 8;
    let within = pos % 8;
    if within < 4 {
        st[2 * lane] = st[2 * lane] ^ v << (8 * within);
    } else {
        st[2 * lane + 1] = st[2 * lane + 1] ^ v << (8 * (within - 4));
    }
    return 0;
}

fn state_byte[&s](st: &s [int], pos: int) -> [] int {
    let lane = pos / 8;
    let within = pos % 8;
    if within < 4 {
        return st[2 * lane] >> (8 * within) & 0xff;
    }
    return st[2 * lane + 1] >> (8 * (within - 4)) & 0xff;
}

// Keccak-256 of `data` into `out` (exactly 32 bytes), using `st` (at least state_len() words, overwritten and left zeroed).
// Returns 0, or a refusal code (refusal_tag).
pub fn hash256[&s, &d, &o](st: &!s [int], data: &d [byte], out: &!o [byte]) -> [] int {
    if len(out) != 32 {
        return -90;
    }
    if len(st) < 110 {
        return -91;
    }
    var i = 0;
    while i < 110 {
        st[i] = 0;
        i = i + 1;
    }
    let rate = 136;
    var pos = 0;
    while len(data) - pos >= rate {
        i = 0;
        while i < rate {
            xor_byte(st, i, int_of(data[pos + i]));
            i = i + 1;
        }
        permute(st);
        pos = pos + rate;
    }
    let rest = len(data) - pos;
    i = 0;
    while i < rest {
        xor_byte(st, i, int_of(data[pos + i]));
        i = i + 1;
    }
    xor_byte(st, rest, 0x01);
    xor_byte(st, rate - 1, 0x80);
    permute(st);
    i = 0;
    while i < 32 {
        out[i] = byte_of(state_byte(st, i));
        i = i + 1;
    }
    i = 0;
    while i < 110 {
        st[i] = 0;
        i = i + 1;
    }
    return 0;
}
