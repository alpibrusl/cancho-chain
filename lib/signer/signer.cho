edition 7;

module chain.signer;

import chain.envelope;
import chain.hex;
import std.bytes;

// The signer's parts that are not input and output (docs/design.md section 14): its refusals and their repairs, the ledger event's payload, and the two small files it reads.

pub fn max_entries() -> [] int {
    return 65536;
}

// `{"id":"<64 hex>","digest":"<64 hex>"}`.
pub fn payload_len() -> [] int {
    return 149;
}

pub fn refused_locked() -> [] int {
    return -270;
}

pub fn refused_same_key() -> [] int {
    return -271;
}

pub fn refused_ledger_corrupt() -> [] int {
    return -272;
}

pub fn refused_ledger_full() -> [] int {
    return -273;
}

pub fn refused_ledger_write() -> [] int {
    return -274;
}

pub fn refused_request() -> [] int {
    return -275;
}

pub fn refused_config() -> [] int {
    return -276;
}

pub fn refused_key() -> [] int {
    return -277;
}

pub fn refused_sign() -> [] int {
    return -278;
}

pub fn refused_clock() -> [] int {
    return -279;
}

// The anchor's refusals (docs/design.md section 19).
pub fn refused_anchor_corrupt() -> [] int {
    return -280;
}

pub fn refused_anchor_missing() -> [] int {
    return -281;
}

pub fn refused_anchor_short() -> [] int {
    return -282;
}

pub fn refused_anchor_mismatch() -> [] int {
    return -283;
}

pub fn refused_anchor_behind() -> [] int {
    return -284;
}

pub fn refused_anchor_write() -> [] int {
    return -285;
}

// The witness's refusals (docs/design.md section 20).
pub fn refused_witness_missing() -> [] int {
    return -286;
}

pub fn refused_witness_short() -> [] int {
    return -287;
}

pub fn refused_witness_mismatch() -> [] int {
    return -288;
}

pub fn refused_witness_behind() -> [] int {
    return -289;
}

// The rule tag of a refusal, without the `chain.` prefix: the envelope's own (-240 to -261) or the signer's.
pub fn refusal_tag(code: int) -> [] &static [byte] {
    if code <= -240 && code >= -261 {
        return envelope.refusal_tag(code);
    }
    if code == -270 {
        return "signer-locked";
    }
    if code == -271 {
        return "signer-same-key";
    }
    if code == -272 {
        return "signer-ledger-corrupt";
    }
    if code == -273 {
        return "signer-ledger-full";
    }
    if code == -274 {
        return "signer-ledger-write";
    }
    if code == -275 {
        return "signer-request";
    }
    if code == -276 {
        return "signer-config";
    }
    if code == -277 {
        return "signer-key";
    }
    if code == -278 {
        return "signer-sign";
    }
    if code == -279 {
        return "signer-clock";
    }
    if code == -280 {
        return "signer-anchor-corrupt";
    }
    if code == -281 {
        return "signer-anchor-missing";
    }
    if code == -282 {
        return "signer-anchor-short";
    }
    if code == -283 {
        return "signer-anchor-mismatch";
    }
    if code == -284 {
        return "signer-anchor-behind";
    }
    if code == -285 {
        return "signer-anchor-write";
    }
    if code == -286 {
        return "signer-witness-missing";
    }
    if code == -287 {
        return "signer-witness-short";
    }
    if code == -288 {
        return "signer-witness-mismatch";
    }
    if code == -289 {
        return "signer-witness-behind";
    }
    return "signer-unknown";
}

// What to do about a refusal, one line, with no value from the request in it.
pub fn repair(code: int) -> [] &static [byte] {
    if code == -270 {
        return "another signer holds this directory; run one at a time";
    }
    if code == -271 {
        return "the issuer address must not be the wallet's: use two keys";
    }
    if code == -272 {
        return "the ledger does not verify; nothing is signed until a person has looked at it";
    }
    if code == -273 {
        return "the ledger holds the most entries this signer reads; archive it";
    }
    if code == -274 {
        return "the ledger could not be written, so nothing was signed; check the disk and retry";
    }
    if code == -275 {
        return "the request line is four hex fields: envelope, signature, message, caller";
    }
    if code == -276 {
        return "signer.conf must be exactly issuer=<40 hex digits> and chain=<decimal>, one to a line";
    }
    if code == -277 {
        return "wallet.key must be 64 hex digits";
    }
    if code == -278 {
        return "the signature could not be made";
    }
    if code == -279 {
        return "the clock could not be read";
    }
    if code == -280 {
        return "the anchor file is not exactly <count> <64 hex digits> and a newline; a person must look at it";
    }
    if code == -281 {
        return "the ledger has entries and there is no anchor; restore it, or write it from the ledger's count and head once a person has checked the ledger";
    }
    if code == -282 {
        return "the ledger has fewer entries than the anchor counted, or the anchor is from another ledger: entries were cut; nothing is signed until a person has looked";
    }
    if code == -283 {
        return "the ledger's entry at the anchor's count is not the anchor's: the ledger was rewritten; nothing is signed until a person has looked";
    }
    if code == -284 {
        return "the ledger is more than one entry ahead of the anchor: the anchor was restored from an older copy; a person must look";
    }
    if code == -285 {
        return "the anchor could not be written, so nothing was signed; check the anchor directory and retry";
    }
    if code == -286 {
        return "the front has no witness and the ledger has more than one entry; restore the front's witness file, or a person must look at the ledger";
    }
    if code == -287 {
        return "the ledger has fewer entries than the front's witness counted: the signer's directory was restored or cut; nothing is signed until a person has looked";
    }
    if code == -288 {
        return "the ledger's entry at the witness's count is not the witness's: the ledger was replaced; nothing is signed until a person has looked";
    }
    if code == -289 {
        return "the ledger is more than one entry ahead of the front's witness: the front's witness was restored from an older copy; a person must look";
    }
    if code == -250 {
        return "the envelope is not a whole version-1 envelope";
    }
    if code == -251 {
        return "the issuer's signature is not a valid low-s signature";
    }
    if code == -252 {
        return "the envelope was not signed by this signer's issuer";
    }
    if code == -253 {
        return "the envelope is for another chain";
    }
    if code == -254 {
        return "the envelope is for another wallet";
    }
    if code == -255 {
        return "the envelope was issued to another caller";
    }
    if code == -256 {
        return "the envelope is not valid yet; check the issuer's clock";
    }
    if code == -257 {
        return "the envelope has expired; ask the policy side for a new decision";
    }
    if code == -258 {
        return "the message is not the transaction the envelope was issued for";
    }
    if code == -259 {
        return "the message is not what the envelope authorises";
    }
    if code == -261 {
        return "this envelope was already used for another transaction";
    }
    return "refused";
}

fn is_lower_hex(c: int) -> [] bool {
    return c >= 48 && c <= 57 || c >= 97 && c <= 102;
}

// The ledger event's payload into `out` (149 bytes): `{"id":"<64 hex>","digest":"<64 hex>"}`, lower-case. `id` and `digest` are 32 bytes each.
pub fn payload[&i, &d, &o](id: &i [byte], digest: &d [byte], out: &!o [byte]) -> [] int {
    if len(id) != 32 || len(digest) != 32 || len(out) != 149 {
        return -272;
    }
    var p = 0;
    let a = "{\"id\":\"";
    while p < 7 {
        out[p] = byte_of(int_of(a[p]));
        p = p + 1;
    }
    hex.encode(id, out[7..71]);
    let b = "\",\"digest\":\"";
    var q = 0;
    while q < 12 {
        out[71 + q] = byte_of(int_of(b[q]));
        q = q + 1;
    }
    hex.encode(digest, out[83..147]);
    out[147] = byte_of(34);
    out[148] = byte_of(125);
    return 149;
}

// Reads a payload back: exactly the shape `payload` writes, lower-case hex, nothing else. `id` and `digest` get 32 bytes each. 0, or -272.
pub fn parse_payload[&p, &i, &d](text: &p [byte], id: &!i [byte], digest: &!d [byte]) -> [] int {
    if len(text) != 149 || len(id) != 32 || len(digest) != 32 {
        return -272;
    }
    var model = true;
    region r {
        let m = alloc_slice[r](149, byte_of(0));
        let zeros = alloc_slice[r](32, byte_of(0));
        payload(zeros, zeros, m);
        var k = 0;
        while k < 149 {
            let inhex = k >= 7 && k < 71 || k >= 83 && k < 147;
            if inhex {
                if !is_lower_hex(int_of(text[k])) {
                    model = false;
                }
            } else if int_of(text[k]) != int_of(m[k]) {
                model = false;
            }
            k = k + 1;
        }
    }
    if !model {
        return -272;
    }
    if hex.decode(text[7..71], id) < 0 || hex.decode(text[83..147], digest) < 0 {
        return -272;
    }
    return 0;
}

// `signer.conf`: exactly `issuer=<40 lower-case hex digits>` and `chain=<1 to 18 decimal digits, no leading zero>`, each ended by a newline (the last may lack it). The issuer's 20 bytes
// go to `issuer`; the chain id is answered (a negative number is a refusal, -276).
pub fn parse_config[&t, &i](text: &t [byte], issuer: &!i [byte]) -> [] int {
    if len(issuer) != 20 || len(text) < 7 + 40 + 1 + 6 + 1 {
        return -276;
    }
    let a = "issuer=";
    var k = 0;
    while k < 7 {
        if int_of(text[k]) != int_of(a[k]) {
            return -276;
        }
        k = k + 1;
    }
    k = 0;
    while k < 40 {
        if !is_lower_hex(int_of(text[7 + k])) {
            return -276;
        }
        k = k + 1;
    }
    if int_of(text[47]) != 10 {
        return -276;
    }
    let b = "chain=";
    k = 0;
    while k < 6 {
        if int_of(text[48 + k]) != int_of(b[k]) {
            return -276;
        }
        k = k + 1;
    }
    var end = len(text);
    if int_of(text[end - 1]) == 10 {
        end = end - 1;
    }
    let digits = end - 54;
    if digits < 1 || digits > 18 || digits > 1 && int_of(text[54]) == 48 {
        return -276;
    }
    var chain = 0;
    k = 0;
    while k < digits {
        let c = int_of(text[54 + k]);
        if c < 48 || c > 57 {
            return -276;
        }
        chain = chain * 10 + (c - 48);
        k = k + 1;
    }
    if hex.decode(text[7..47], issuer) < 0 {
        return -276;
    }
    return chain;
}

// `wallet.key`: 64 hex digits (either case), then at most one newline. The 32 bytes go to `key`. 0, or -277.
pub fn parse_key[&t, &o](text: &t [byte], key: &!o [byte]) -> [] int {
    if len(key) != 32 {
        return -277;
    }
    var n = len(text);
    if n == 65 && int_of(text[64]) == 10 {
        n = 64;
    }
    if n != 64 {
        return -277;
    }
    if hex.decode(text[0..64], key) < 0 {
        return -277;
    }
    return 0;
}

// The anchor's file (docs/design.md section 19.2): `<count> <head>` and a newline, the count in decimal with no leading zero (1 to `max_entries`), the head 64 lower-case hex digits.
pub fn anchor_max_len() -> [] int {
    return 71;
}

// Reads it back: the count is answered and the head's 64 digits go to `head`; -280 if the text is anything else.
pub fn parse_anchor[&t, &h](text: &t [byte], head: &!h [byte]) -> [] int {
    if len(head) != 64 || len(text) < 67 || len(text) > 71 {
        return -280;
    }
    var sp = 0;
    while sp < len(text) && int_of(text[sp]) != 32 {
        sp = sp + 1;
    }
    if sp < 1 || sp > 5 || len(text) != sp + 66 {
        return -280;
    }
    if int_of(text[sp + 65]) != 10 {
        return -280;
    }
    if sp > 1 && int_of(text[0]) == 48 {
        return -280;
    }
    var count = 0;
    var k = 0;
    while k < sp {
        let c = int_of(text[k]);
        if c < 48 || c > 57 {
            return -280;
        }
        count = count * 10 + (c - 48);
        k = k + 1;
    }
    if count < 1 || count > max_entries() {
        return -280;
    }
    k = 0;
    while k < 64 {
        if !is_lower_hex(int_of(text[sp + 1 + k])) {
            return -280;
        }
        head[k] = text[sp + 1 + k];
        k = k + 1;
    }
    return count;
}

// Writes `count` and `head` (64 hex digits) as the file's text into `out` (at least 71 bytes); answers the length, or -280.
pub fn format_anchor[&h, &o](count: int, head: &h [byte], out: &!o [byte]) -> [] int {
    if count < 1 || count > max_entries() || len(head) != 64 || len(out) < 71 {
        return -280;
    }
    var digits = 1;
    var t = count;
    while t >= 10 {
        t = t / 10;
        digits = digits + 1;
    }
    var at = digits - 1;
    var v = count;
    while at >= 0 {
        out[at] = byte_of(48 + v % 10);
        v = v / 10;
        at = at - 1;
    }
    out[digits] = byte_of(32);
    var k = 0;
    while k < 64 {
        if !is_lower_hex(int_of(head[k])) {
            return -280;
        }
        out[digits + 1 + k] = head[k];
        k = k + 1;
    }
    out[digits + 65] = byte_of(10);
    return digits + 66;
}
