edition 7;

module chain.hex;

// Hexadecimal text and bytes (docs/design.md section 8.1). Output is lowercase; input may be either case.

// the hex input has the wrong length for its output
pub fn refused_length() -> [] int {
    return -130;
}

// a character that is not a hex digit
pub fn refused_digit() -> [] int {
    return -131;
}

pub fn refusal_tag(code: int) -> [] &static [byte] {
    if code == -130 {
        return "hex-length";
    }
    if code == -131 {
        return "hex-digit";
    }
    return "hex-unknown";
}

// the lowercase character of a value 0 to 15
pub fn digit(v: int) -> [] int {
    if v < 10 {
        return 48 + v;
    }
    return 87 + v;
}

// the value of the hex character `c`, or -1
pub fn value(c: int) -> [] int {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    if c >= 97 && c <= 102 {
        return c - 87;
    }
    if c >= 65 && c <= 70 {
        return c - 55;
    }
    return -1;
}

// `src` as lowercase hex into `out`, which must be exactly twice as long.
pub fn encode[&s, &o](src: &s [byte], out: &!o [byte]) -> [] int {
    if len(out) != 2 * len(src) {
        return -130;
    }
    var i = 0;
    while i < len(src) {
        let v = int_of(src[i]);
        out[2 * i] = byte_of(digit(v >> 4));
        out[2 * i + 1] = byte_of(digit(v & 15));
        i = i + 1;
    }
    return 0;
}

// `text` (hex, either case) into `out`, which must be exactly half as long. `out` is zero after a refusal.
pub fn decode[&t, &o](text: &t [byte], out: &!o [byte]) -> [] int {
    if len(text) != 2 * len(out) {
        return -130;
    }
    var bad = 0;
    var i = 0;
    while i < len(out) {
        let hi = value(int_of(text[2 * i]));
        let lo = value(int_of(text[2 * i + 1]));
        if hi < 0 || lo < 0 {
            bad = 1;
            out[i] = byte_of(0);
        } else {
            out[i] = byte_of(hi * 16 + lo);
        }
        i = i + 1;
    }
    if bad != 0 {
        i = 0;
        while i < len(out) {
            out[i] = byte_of(0);
            i = i + 1;
        }
        return -131;
    }
    return 0;
}
