edition 11;

// The executor (docs/design.md section 18): one tick per process. It asks two providers what they see, decides with the lifecycle what to do, sends the same bytes again when that is what
// the lifecycle says, and leaves evidence of every change. Authority (`cancho authority`): one directory, two outbound addresses (the providers), the clock, the heap, standard output.
// The directory and the two addresses are compile-time constants, so that the report names them; `scripts/check_executor.py` builds a copy with others.

import chain.erc20;
import chain.executor;
import chain.hex;
import chain.keccak;
import chain.lifecycle;
import chain.rpc;
import chain.txcheck;
import crc;
import log;
import record;
import segment;
import std.buffer;
import std.bytes;
import std.conns;
import fetch_io as fio;
import http_client as hc;
import std.io;
import trail;

fn max_log_len() -> [] int {
    return 4096;
}

fn say[&i](io: &!i Io, text: &static [byte]) -> [io_write] int {
    io.write_all(io, text);
    return 0;
}

fn refuse[&i](io: &!i Io, code: int) -> [io_write] int {
    say(io, "{\"ok\":false,\"rule\":\"chain.");
    io.write_all(io, executor.refusal_tag(code));
    say(io, "\",\"repair\":\"");
    io.write_all(io, executor.repair(code));
    say(io, "\"}");
    io.newline(io);
    return 2;
}

// The whole of the file `path` (at most `len(out)` bytes) into `out`: its length, -1 if it cannot be opened (it is not there), or -2 if it is there and cannot be read whole.
fn read_small[&c, &p, &o](fs: &c Fs("/var/lib/cancho-executor"), path: &p [byte], out: &!o [byte]) -> [fs_read("/var/lib/cancho-executor"), file_read] int {
    var got = -1;
    match open_read(fs, path) {
        Opened::Failed(e) => {
            got = -1;
        }
        Opened::Ok(opened) => {
            got = -2;
            var f = opened;
            borrow mut f as &!h in {
                match file_size(h) {
                    Done::Failed(e) => {
                        got = -2;
                    }
                    Done::Ok(size) => {
                        if size <= len(out) {
                            var have = 0;
                            var ok = true;
                            while have < size && ok {
                                match file_pread(h, have, out[have..size]) {
                                    Read::Got(n) => {
                                        have = have + n;
                                    }
                                    Read::End => {
                                        ok = false;
                                    }
                                    Read::Failed(e) => {
                                        ok = false;
                                    }
                                }
                            }
                            if ok {
                                got = size;
                            }
                        }
                    }
                }
            }
            file_close(f);
        }
    }
    return got;
}

// The text of a hex file (one line, an optional newline) decoded into `out`: its byte length, -1 if the file is not there, or -2 if it is there and is not hex that fits.
fn read_hex_file[&c, &p, &o, &b](fs: &c Fs("/var/lib/cancho-executor"), path: &p [byte], text: &!b [byte], out: &!o [byte]) -> [fs_read("/var/lib/cancho-executor"), file_read] int {
    let n = read_small(fs, path, text);
    if n < 0 {
        return n;
    }
    var end = n;
    if end > 0 && int_of(text[end - 1]) == 10 {
        end = end - 1;
    }
    if end == 0 || end % 2 != 0 || end / 2 > len(out) {
        return -2;
    }
    if hex.decode(text[0..end], out[0..end / 2]) < 0 {
        return -2;
    }
    return end / 2;
}

// ---------------------------------------------------------------------
// The providers: HTTP/1.1 over TCP or TLS 1.3, through `packages/http-client` and cancho's `fetch_io` driver, with a deadline (design section 21)
// ---------------------------------------------------------------------

// What a provider is, fixed at build time (so that `cancho authority` names exactly what the executor can reach): its host, its port (also in the `Out` types below)
// and whether it speaks TLS. The harness of `scripts/check_executor.py` builds copies with others.
fn host_a() -> [] &static [byte] {
    return "127.0.0.1";
}

fn host_b() -> [] &static [byte] {
    return "127.0.0.1";
}

fn port_a() -> [] int {
    return 18545;
}

fn port_b() -> [] int {
    return 18546;
}

fn secure_a() -> [] int {
    return 0;
}

fn secure_b() -> [] int {
    return 0;
}

// Dialled by name: the provider's `Out` is `net_out("<host>:<port>")` and nothing wider. `tcp_connect_start` makes the socket non-blocking before it connects, so the TCP handshake is the poller's and
// the 3,000 ms are its deadline (`docs/native-sockets.md` 10.6); only the name's lookup (`getaddrinfo`) is a blocking call, outside the deadline (design 21.2 D6).
fn dial_a[&o](out: &o Out("127.0.0.1:18545")) -> [net_out("127.0.0.1:18545")] Dialed {
    return tcp_connect_start(out, host_a(), 18545);
}

fn dial_b[&o](out: &o Out("127.0.0.1:18546")) -> [net_out("127.0.0.1:18546")] Dialed {
    return tcp_connect_start(out, host_b(), 18546);
}

// The area of network facts a tick keeps in `nb` (design 21.2): the tick's entropy, a counter, each provider's request path, and the PEM roots.
fn nb_seed() -> [] int {
    return 0;
}

fn nb_counter() -> [] int {
    return 32;
}

fn nb_target_len() -> [] int {
    return 40;
}

fn nb_roots_len() -> [] int {
    return 44;
}

fn nb_target() -> [] int {
    return 64;
}

fn nb_roots() -> [] int {
    return 1024;
}

fn nb_roots_max() -> [] int {
    return 24576;
}

fn nb_len() -> [] int {
    return 1024 + 24576;
}

fn limits() -> [] hc.Limits {
    return hc.Limits { connect_ms: 3000, head_ms: 3000, body_ms: 3000, total_ms: 3000, expect_ms: 1000, idle_ms: 3000, lifetime_ms: 5000, idle_per_key: 1, max_requests: 100 };
}

// Entropy for one connection: the tick's, hashed with a counter, so that no two connections of a tick (nor of two ticks) start the TLS engine's generator from the same bytes.
fn fresh_seed[&k, &n, &o](st: &!k [int], nb: &!n [byte], out: &!o [byte]) -> [] int {
    var c = 0;
    var i = 0;
    while i < 4 {
        c = c * 256 + int_of(nb[nb_counter() + i]);
        i = i + 1;
    }
    c = c + 1;
    i = 0;
    while i < 4 {
        nb[nb_counter() + i] = byte_of(c >> 8 * (3 - i) & 255);
        i = i + 1;
    }
    var code = 0;
    region g {
        let input = alloc_slice[g](36, byte_of(0));
        i = 0;
        while i < 32 {
            input[i] = nb[nb_seed() + i];
            i = i + 1;
        }
        i = 0;
        while i < 4 {
            input[32 + i] = nb[nb_counter() + i];
            i = i + 1;
        }
        code = keccak.hash256(st, input, out);
    }
    return code;
}

// A provider's connection for the calls of one query (design 21.2 D6): the driver's loop, the HTTP client with one slot, and the upstream's number (-1 if the provider cannot be used: no roots, no entropy).
// The connection is dialled by the first request and kept for the next ones, so a tick makes one handshake per provider for its queries, not one per call.
enum Session {
    Up(fio.Loop, hc.Client, int),
    Down,
}

fn open_session[&h, &n, &s](heap: &!h Heap, which: int, nb: &!n [byte], st: &!s [int]) -> [heap] Session {
    var secure = secure_a() == 1;
    var host = host_a();
    var port = port_a();
    if which == 1 {
        secure = secure_b() == 1;
        host = host_b();
        port = port_b();
    }
    match fio.open(heap, 1, secure) {
        fio.Started::Failed(e) => {
            return Session::Down;
        }
        fio.Started::Ok(l) => {
            var iov = l;
            var upstream = -1;
            region g {
                let entropy = alloc_slice[g](32, byte_of(0));
                var roots = 1;
                borrow mut iov as &!ioh in {
                    if secure {
                        if fresh_seed(st, nb, entropy) != 0 || fio.seed(ioh, entropy) != 0 {
                            roots = 0;
                        } else {
                            var rl = 0;
                            var q = 0;
                            while q < 4 {
                                rl = rl * 256 + int_of(nb[nb_roots_len() + q]);
                                q = q + 1;
                            }
                            roots = fio.trust(ioh, nb[nb_roots()..nb_roots() + rl]);
                        }
                    }
                    if roots > 0 {
                        upstream = fio.add_upstream(ioh, "127.0.0.1", port, secure, host);
                    }
                }
            }
            return Session::Up(iov, hc.open(heap, 1, 65536, 16384, limits()), upstream);
        }
    }
}

// The session ends: idle connections are told to close (with close_notify if TLS), and the loop and the client are given back.
fn close_session[&h, &k](heap: &!h Heap, clock: &k Clock, iov0: fio.Loop, client0: hc.Client) -> [heap, clock, conn_write] int {
    var iov = iov0;
    var client = client0;
    borrow mut client as &!cw in {
        hc.close_idle(cw, clock_ms(clock));
        var closing = true;
        while closing {
            match hc.poll(cw, clock_ms(clock)) {
                hc.Event::Close(slot) => {
                    borrow mut iov as &!ioh in {
                        fio.shut(ioh, cw, slot, clock_ms(clock));
                    }
                }
                hc.Event::None => {
                    closing = false;
                }
                _ => {
                }
            }
        }
    }
    hc.close(heap, client);
    fio.close(heap, iov);
    return 0;
}

// Ask provider `which` (0 or 1) with the JSON `body` on the session's connection: the answer's body is in `resp[0..info[1]]` (`info[0]` is 0). The loop comes back with the status: 0, or -341 (the provider cannot be reached, the handshake
// or the framing failed), -342 (a status other than 200), -344 (an answer that is too long, or the 3,000 ms are over).
fn ask[&h, &k, &oa, &ob, &b, &w, &r, &i, &c, &n](heap: &!h Heap, clock: &k Clock, which: int, a: &oa Out("127.0.0.1:18545"), b: &ob Out("127.0.0.1:18546"), body: &b [byte], wire: &!w [byte], resp: &!r [byte], info: &!i [int], iov0: fio.Loop, cw: &!c hc.Client, upstream: int, nb: &n [byte]) -> [heap, net_out("127.0.0.1:18545"), net_out("127.0.0.1:18546"), poll, clock, conn_read, conn_write] (fio.Loop, int) {
    var status = -341;
    var iov = iov0;
    var host = host_a();
    var tlen = int_of(nb[nb_target_len()]);
    var toff = nb_target();
    if which == 1 {
        host = host_b();
        tlen = int_of(nb[nb_target_len() + 1]);
        toff = nb_target() + 256;
    }
    info[0] = 0;
    info[1] = 0;
    let started_at = clock_ms(clock);
    if upstream >= 0 {
        let now0 = clock_ms(clock);
        // What the last call left for the loop (a connection that cannot be reused is told to close, and its slot is free only after that): before a new request.
        var pre = true;
        while pre {
            match hc.poll(cw, now0) {
                hc.Event::Close(slot) => {
                    borrow mut iov as &!ioh in {
                        fio.shut(ioh, cw, slot, now0);
                    }
                }
                hc.Event::None => {
                    pre = false;
                }
                _ => {
                }
            }
        }
        var t = 0;
        if tlen > 0 {
            t = hc.request(cw, now0, upstream, "POST", nb[toff..toff + tlen], host, "Content-Type: application/json\r\n", len(body), 0);
        } else {
            t = hc.request(cw, now0, upstream, "POST", "/", host, "Content-Type: application/json\r\n", len(body), 0);
        }
        if t > 0 {
            var sent = 0;
            var got = 0;
            var finished = false;
            var now = now0;
            while status == -341 && !finished && now - started_at < 3000 {
                if sent < len(body) {
                    let m = hc.send_body(cw, t, body[sent..len(body)], now);
                    if m > 0 {
                        sent = sent + m;
                    }
                }
                var wait = 3000 - (now - started_at);
                if wait > 100 {
                    wait = 100;
                }
                // The first turn only asks the client for what it wants (the connection to dial): nothing is there to wait for yet.
                if now == now0 {
                    wait = 0;
                }
                borrow mut iov as &!ioh in {
                    fio.step(ioh, cw, clock, wait);
                }
                now = clock_ms(clock);
                var going = true;
                while going {
                    match hc.poll(cw, now) {
                        hc.Event::None => {
                            going = false;
                        }
                        hc.Event::Connect(slot) => {
                            var dialled = false;
                            if which == 0 {
                                match dial_a(a) {
                                    Dialed::Ok(c) => {
                                        iov = fio.adopt(heap, iov, c, cw, slot, now);
                                        dialled = true;
                                    }
                                    Dialed::Failed(e) => {
                                    }
                                }
                            } else {
                                match dial_b(b) {
                                    Dialed::Ok(c) => {
                                        iov = fio.adopt(heap, iov, c, cw, slot, now);
                                        dialled = true;
                                    }
                                    Dialed::Failed(e) => {
                                    }
                                }
                            }
                            if !dialled {
                                hc.connect_failed(cw, slot, hc.kind_connect(), now);
                            }
                        }
                        hc.Event::Close(slot) => {
                            borrow mut iov as &!ioh in {
                                fio.shut(ioh, cw, slot, now);
                            }
                        }
                        hc.Event::Head(tk) => {
                            if hc.status(cw, tk) != 200 {
                                status = -342;
                                going = false;
                            }
                        }
                        hc.Event::Body(tk) => {
                            let avail = hc.avail(cw, tk);
                            if got + avail > len(resp) {
                                status = -344;
                                going = false;
                            } else {
                                let piece = hc.body(cw, tk);
                                var z = 0;
                                while z < avail {
                                    resp[got + z] = piece[z];
                                    z = z + 1;
                                }
                                got = got + avail;
                                hc.consume(cw, tk, avail, now);
                            }
                        }
                        hc.Event::Done(tk) => {
                            finished = true;
                            info[1] = got;
                            status = 0;
                            going = false;
                        }
                        hc.Event::Failed(tk) => {
                            status = -341;
                            finished = true;
                            going = false;
                        }
                        hc.Event::Continue(tk) => {
                        }
                    }
                }
                hc.tick(cw, now);
            }
            if status == -341 && !finished && now - started_at >= 3000 {
                status = -344;
            }
        }
    }
    return (iov, status);
}

// The state a tick works with, in one record so that the functions below do not carry twenty arguments: `ints` and `bytes` hold the facts of each provider (§18.2 step 5), `tape`, `resp`, `wire` and `req` are the buffers.
//   ints, provider p at 8 * p: [0] usable  [1] kind (0 not found, 1 pending, 2 mined)  [2] status_ok  [3] block  [4] latest nonce  [5] tip  [6] chain id wrong  [7] unused
//   bytes, provider p at 64 * p: [0..32] the block hash  [32..64] the hash now at that height
fn call_one[&h, &k, &oa, &ob, &t, &q, &w, &r, &i, &j, &c, &nbx](heap: &!h Heap, clock: &k Clock, which: int, a: &oa Out("127.0.0.1:18545"), b: &ob Out("127.0.0.1:18546"), id: int, request_len: int, req: &q [byte], wire: &!w [byte], resp: &!r [byte], hi: &!i [int], tape: &!t [int], ri: &!j [int], nb: &nbx [byte], iov0: fio.Loop, cw: &!c hc.Client, upstream: int) -> [heap, net_out("127.0.0.1:18545"), net_out("127.0.0.1:18546"), poll, clock, conn_read, conn_write] (fio.Loop, int) {
    let (iov, status) = ask(heap, clock, which, a, b, req[0..request_len], wire, resp, hi, iov0, cw, upstream, nb);
    if status < 0 {
        return (iov, -1);
    }
    let kind = rpc.response(resp[hi[0]..hi[0] + hi[1]], tape, id, ri);
    if kind != 0 {
        return (iov, -1);
    }
    return (iov, ri[0]);
}

fn query_calls[&h, &k, &oa, &ob, &t, &w, &r, &q, &f, &x, &wa, &tk, &cd, &th, &nbx, &c](heap: &!h Heap, clock: &k Clock, which: int, a: &oa Out("127.0.0.1:18545"), b: &ob Out("127.0.0.1:18546"), chain: int, nonce: int, wallet: &wa [byte], token: &tk [byte], calldata: &cd [byte], tx_hash: &th [byte], tape: &!t [int], wire: &!w [byte], resp: &!r [byte], req: &!q [byte], ints: &!f [int], bytes_: &!x [byte], nb: &nbx [byte], iov0: fio.Loop, cw: &!c hc.Client, upstream: int) -> [heap, net_out("127.0.0.1:18545"), net_out("127.0.0.1:18546"), poll, clock, conn_read, conn_write] fio.Loop {
    let off = 8 * which;
    let boff = 64 * which;
    ints[off] = 0;
    ints[off + 6] = 0;
    var done = 0;
    var iov = iov0;
    region g {
        let hi = alloc_slice[g](2, 0);
        let ri = alloc_slice[g](4, 0);
        // 1. the chain id: a provider for another chain is not unusable, it is refused.
        var n = rpc.req_chain_id(1, req);
        let (iv1, nd1) = call_one(heap, clock, which, a, b, 1, n, req, wire, resp, hi, tape, ri, nb, iov, cw, upstream);
        iov = iv1;
        var node = nd1;
        if node < 0 {
            done = 1;
        } else {
            let c = rpc.chain_id_is(resp[hi[0]..hi[0] + hi[1]], tape, node, chain);
            if c == -308 {
                ints[off + 6] = 1;
                done = 1;
            } else if c < 0 {
                done = 1;
            }
        }
        // 2. the account's latest nonce, 3. the tip.
        if done == 0 {
            n = rpc.req_nonce(2, wallet, false, req);
            let (iv2, nd2) = call_one(heap, clock, which, a, b, 2, n, req, wire, resp, hi, tape, ri, nb, iov, cw, upstream);
            iov = iv2;
            node = nd2;
            let v = rpc.quantity(resp[hi[0]..hi[0] + hi[1]], tape, node);
            if node < 0 || v < 0 {
                done = 1;
            } else {
                ints[off + 4] = v;
            }
        }
        if done == 0 {
            n = rpc.req_block_number(3, req);
            let (iv3, nd3) = call_one(heap, clock, which, a, b, 3, n, req, wire, resp, hi, tape, ri, nb, iov, cw, upstream);
            iov = iv3;
            node = nd3;
            let v = rpc.quantity(resp[hi[0]..hi[0] + hi[1]], tape, node);
            if node < 0 || v < 0 {
                done = 1;
            } else {
                ints[off + 5] = v;
            }
        }
        // 4. the transaction, 5. its receipt.
        var tx_kind = 0;
        var tx_block = 0;
        if done == 0 {
            n = rpc.req_tx(4, tx_hash, req);
            let (iv4, nd4) = call_one(heap, clock, which, a, b, 4, n, req, wire, resp, hi, tape, ri, nb, iov, cw, upstream);
            iov = iv4;
            node = nd4;
            if node < 0 {
                done = 1;
            } else {
                tx_kind = rpc.tx_check(resp[hi[0]..hi[0] + hi[1]], tape, node, tx_hash, wallet, token, nonce, calldata, ri);
                tx_block = ri[0];
                if tx_kind < 0 {
                    done = 1;
                }
            }
        }
        var rc = 0;
        var block = 0;
        if done == 0 {
            n = rpc.req_receipt(5, tx_hash, req);
            let (iv5, nd5) = call_one(heap, clock, which, a, b, 5, n, req, wire, resp, hi, tape, ri, nb, iov, cw, upstream);
            iov = iv5;
            node = nd5;
            if node < 0 {
                done = 1;
            } else {
                rc = rpc.receipt(resp[hi[0]..hi[0] + hi[1]], tape, node, tx_hash, wallet, token, ri, bytes_[boff..boff + 32]);
                block = ri[0];
                if rc < 0 {
                    done = 1;
                }
            }
        }
        // The two must say the same thing: a receipt with no transaction mined, or a mined transaction with no receipt or another block, is a provider contradicting itself.
        if done == 0 {
            if rc != 0 && (tx_kind != 2 || tx_block != block) || rc == 0 && tx_kind == 2 {
                done = 1;
            }
        }
        // 6. If it is mined, the hash now at its height.
        if done == 0 && rc != 0 {
            n = rpc.req_block(6, block, req);
            let (iv6, nd6) = call_one(heap, clock, which, a, b, 6, n, req, wire, resp, hi, tape, ri, nb, iov, cw, upstream);
            iov = iv6;
            node = nd6;
            if node < 0 || rpc.block_check(resp[hi[0]..hi[0] + hi[1]], tape, node, block, bytes_[boff + 32..boff + 64]) != 1 {
                done = 1;
            }
        }
        if done == 0 {
            ints[off] = 1;
            if rc != 0 {
                ints[off + 1] = 2;
                ints[off + 3] = block;
                if rc == 1 {
                    ints[off + 2] = 1;
                } else {
                    ints[off + 2] = 0;
                }
            } else {
                ints[off + 1] = tx_kind;
                ints[off + 2] = 0;
                ints[off + 3] = 0;
            }
        }
    }
    return iov;
}

fn query[&h, &k, &oa, &ob, &t, &w, &r, &q, &f, &x, &wa, &tk, &cd, &th, &nbx, &stx](heap: &!h Heap, clock: &k Clock, which: int, a: &oa Out("127.0.0.1:18545"), b: &ob Out("127.0.0.1:18546"), chain: int, nonce: int, wallet: &wa [byte], token: &tk [byte], calldata: &cd [byte], tx_hash: &th [byte], tape: &!t [int], wire: &!w [byte], resp: &!r [byte], req: &!q [byte], ints: &!f [int], bytes_: &!x [byte], nb: &!nbx [byte], st: &!stx [int]) -> [heap, net_out("127.0.0.1:18545"), net_out("127.0.0.1:18546"), poll, clock, conn_read, conn_write] int {
    let off = 8 * which;
    ints[off] = 0;
    ints[off + 6] = 0;
    match open_session(heap, which, nb, st) {
        Session::Down => {
        }
        Session::Up(l0, c0, upstream) => {
            var iov = l0;
            var client = c0;
            if upstream >= 0 {
                borrow mut client as &!cw in {
                    iov = query_calls(heap, clock, which, a, b, chain, nonce, wallet, token, calldata, tx_hash, tape, wire, resp, req, ints, bytes_, nb, iov, cw, upstream);
                }
            }
            close_session(heap, clock, iov, client);
        }
    }
    return 0;
}

// Do the two providers say the same? Both usable; the same on the transaction (not found, pending, or mined with the same status, block, block hash and hash at that height) and on the nonce.
fn agree[&f, &x](ints: &f [int], bytes_: &x [byte]) -> [] bool {
    if ints[0] != 1 || ints[8] != 1 {
        return false;
    }
    if ints[1] != ints[9] || ints[4] != ints[12] {
        return false;
    }
    if ints[1] == 2 {
        if ints[2] != ints[10] || ints[3] != ints[11] {
            return false;
        }
        var i = 0;
        while i < 32 {
            if int_of(bytes_[i]) != int_of(bytes_[64 + i]) || int_of(bytes_[32 + i]) != int_of(bytes_[96 + i]) {
                return false;
            }
            i = i + 1;
        }
    }
    return true;
}

// `raw` sent to provider `which`: did it take the transaction (its `result` is this transaction's hash)?
fn send_to[&h, &k, &oa, &ob, &t, &w, &r, &q, &y, &th, &nbx, &stx](heap: &!h Heap, clock: &k Clock, which: int, a: &oa Out("127.0.0.1:18545"), b: &ob Out("127.0.0.1:18546"), raw: &y [byte], tx_hash: &th [byte], tape: &!t [int], wire: &!w [byte], resp: &!r [byte], req: &!q [byte], nb: &!nbx [byte], st: &!stx [int]) -> [heap, net_out("127.0.0.1:18545"), net_out("127.0.0.1:18546"), poll, clock, conn_read, conn_write] bool {
    var took = false;
    match open_session(heap, which, nb, st) {
        Session::Down => {
        }
        Session::Up(l0, c0, upstream) => {
            var iov = l0;
            var client = c0;
            if upstream >= 0 {
                borrow mut client as &!cw in {
                    region g {
                        let hi = alloc_slice[g](2, 0);
                        let ri = alloc_slice[g](4, 0);
                        let got = alloc_slice[g](32, byte_of(0));
                        let n = rpc.req_send_raw(7, raw, req);
                        if n > 0 {
                            let (iv, node) = call_one(heap, clock, which, a, b, 7, n, req, wire, resp, hi, tape, ri, nb, iov, cw, upstream);
                            iov = iv;
                            if node >= 0 && rpc.hash32(resp[hi[0]..hi[0] + hi[1]], tape, node, got) == 0 && bytes.equal(got, tx_hash) {
                                took = true;
                            }
                        }
                    }
                }
            }
            close_session(heap, clock, iov, client);
        }
    }
    return took;
}

fn be8[&c](c: &c [byte], at: int) -> [] int {
    var v = 0;
    var i = 0;
    while i < 8 {
        v = v * 256 + int_of(c[at + i]);
        i = i + 1;
    }
    return v;
}

// The tick, once the evidence log is open and verified: the job is checked, the providers asked, the lifecycle applied, what must be sent is sent, the evidence written and the state kept.
fn core[&c, &k, &i, &q, &oa, &ob, &l, &hd, &t, &r, &w, &rq, &f, &x, &s, &g, &e, &y, &th, &cd, &nbx](fs: &c Fs("/var/lib/cancho-executor"), clock: &k Clock, io: &!i Io, heap: &!q Heap, a: &oa Out("127.0.0.1:18545"), b: &ob Out("127.0.0.1:18546"), lg: &!l log.Log, head: &!hd [byte], tape: &!t [int], resp: &!r [byte], wire: &!w [byte], req: &!rq [byte], ints: &!f [int], bytes_: &!x [byte], config: &g [int], env: &e [byte], raw: &y [byte], tx_hash: &th [byte], calldata: &cd [byte], st: &!s [int], nb: &!nbx [byte]) -> [fs_read("/var/lib/cancho-executor"), fs_write("/var/lib/cancho-executor"), file_read, file_write, heap, net_out("127.0.0.1:18545"), net_out("127.0.0.1:18546"), poll, clock, io_write, conn_read, conn_write] int {
    var status = 2;
    region g2 {
        let rec = alloc_slice[g2](74, byte_of(0));
        let prev = alloc_slice[g2](74, byte_of(0));
        let text = alloc_slice[g2](200, byte_of(0));
        let ms = clock_unix_ms(clock);
        if ms < 0 {
            return refuse(io, -338);
        }
        let nonce = be8(env, 197);
        // The state: the file, or a new record.
        let n = read_hex_file(fs, "/var/lib/cancho-executor/state", text, rec);
        if n == 74 {
            if lifecycle.check(rec) != 0 || lifecycle.nonce(rec) != nonce {
                return refuse(io, -336);
            }
            var j = 0;
            while j < 74 {
                prev[j] = rec[j];
                j = j + 1;
            }
        } else if n != -1 {
            return refuse(io, -336);
        } else {
            lifecycle.new(rec, nonce, ms);
        }
        // Ask both providers.
        query(heap, clock, 0, a, b, config[0], nonce, env[105..125], env[125..145], calldata, tx_hash, tape, wire, resp, req, ints, bytes_, nb, st);
        query(heap, clock, 1, a, b, config[0], nonce, env[105..125], env[125..145], calldata, tx_hash, tape, wire, resp, req, ints, bytes_, nb, st);
        if ints[6] == 1 || ints[14] == 1 {
            return refuse(io, -335);
        }
        var same = agree(ints, bytes_);
        var tip = ints[5];
        if ints[13] < tip {
            tip = ints[13];
        }
        var kind = ints[1];
        if kind == 2 && tip < ints[3] {
            // Behind the block it names (the lower tip decides): no decision, and the record is not shown a block it cannot be in.
            same = false;
            kind = 0;
        }
        var action = 0;
        let hat = alloc_slice[g2](32, byte_of(0));
        var j2 = 0;
        while j2 < 32 {
            hat[j2] = bytes_[32 + j2];
            j2 = j2 + 1;
        }
        let bh = bytes_[0..32];
        let o = lifecycle.observe(rec, same, kind, ints[2] == 1, ints[3], bh, tip, kind == 2, hat, ints[4], ms, config[1], config[2], config[3]);
        if o < 0 {
            return refuse(io, -336);
        }
        action = o;
        var sent = false;
        if action == 1 || action == 2 {
            let took_a = send_to(heap, clock, 0, a, b, raw, tx_hash, tape, wire, resp, req, nb, st);
            let took_b = send_to(heap, clock, 1, a, b, raw, tx_hash, tape, wire, resp, req, nb, st);
            sent = took_a || took_b;
            lifecycle.after_send(rec, sent, ms);
        }
        // Evidence, if the state or the block changed; then the state.
        var changed = int_of(rec[1]) != int_of(prev[1]);
        var m = 34;
        while m < 74 {
            if int_of(rec[m]) != int_of(prev[m]) {
                changed = true;
            }
            m = m + 1;
        }
        var failure = 0;
        if changed {
            let body = alloc_slice[g2](220, byte_of(0));
            let scratch = alloc_slice[g2](1024, byte_of(0));
            let parent = alloc_slice[g2](64, byte_of(0));
            let blen = executor.payload(env[1..33], tx_hash, lifecycle.state(rec), lifecycle.block(rec), body);
            var plen = 0;
            if log.records(lg) > 0 {
                plen = 64;
                var q2 = 0;
                while q2 < 64 {
                    parent[q2] = head[q2];
                    q2 = q2 + 1;
                }
            }
            // The payload's length first: a negative one is a failed payload, and must not be used as the end of a slice.
            if blen < 0 {
                failure = -332;
            } else {
                let r2 = trail.append(lg, head, scratch, "tx.state", parent[0..plen], body[0..blen], ms, max_log_len());
                if r2.0 != 0 || log.flush(lg) != 0 {
                    failure = -332;
                }
            }
        }
        if failure != 0 {
            return refuse(io, failure);
        }
        let line = alloc_slice[g2](149, byte_of(0));
        hex.encode(rec, line[0..148]);
        line[148] = byte_of(10);
        if fs_write(fs, "/var/lib/cancho-executor/state.new", line) != 149 {
            return refuse(io, -337);
        }
        match fs_rename(fs, "/var/lib/cancho-executor/state.new", "/var/lib/cancho-executor/state") {
            Done::Ok(z) => {
                status = 0;
            }
            Done::Failed(e2) => {
                return refuse(io, -337);
            }
        }
        say(io, "{\"ok\":true,\"state\":\"");
        io.write_all(io, lifecycle.state_name(lifecycle.state(rec)));
        if action == 0 {
            say(io, "\",\"action\":\"nothing\",\"sent\":");
        } else if action == 1 {
            say(io, "\",\"action\":\"submit\",\"sent\":");
        } else {
            say(io, "\",\"action\":\"resubmit\",\"sent\":");
        }
        if sent {
            say(io, "true,\"agree\":");
        } else {
            say(io, "false,\"agree\":");
        }
        if same {
            say(io, "true}");
        } else {
            say(io, "false}");
        }
        io.newline(io);
    }
    return status;
}

// Opens the evidence log, locks it, verifies it whole and read-only, recovers a torn tail (the signer's rule, docs/design.md section 14.3), and runs `core`.
fn with_evidence[&c, &k, &i, &q, &oa, &ob, &t, &r, &w, &rq, &f, &x, &s, &g, &e, &y, &th, &cd, &nbx](fs: &c Fs("/var/lib/cancho-executor"), clock: &k Clock, io: &!i Io, heap: &!q Heap, a: &oa Out("127.0.0.1:18545"), b: &ob Out("127.0.0.1:18546"), tape: &!t [int], resp: &!r [byte], wire: &!w [byte], req: &!rq [byte], ints: &!f [int], bytes_: &!x [byte], config: &g [int], env: &e [byte], raw: &y [byte], tx_hash: &th [byte], calldata: &cd [byte], st: &!s [int], nb: &!nbx [byte]) -> [fs_read("/var/lib/cancho-executor"), fs_write("/var/lib/cancho-executor"), file_read, file_write, heap, net_out("127.0.0.1:18545"), net_out("127.0.0.1:18546"), poll, clock, io_write, conn_read, conn_write] int {
    var status = 2;
    region r {
        let window = alloc_slice[r](max_log_len() + 4096, byte_of(0));
        let head = alloc_slice[r](64, byte_of(0));
        let path = "/var/lib/cancho-executor/evidence.seg";
        match open_append(fs, path) {
            Opened::Failed(e2) => {
                status = refuse(io, -332);
            }
            Opened::Ok(w0) => {
                match open_rw(fs, path) {
                    Opened::Failed(e2) => {
                        status = refuse(io, -332);
                        file_close(w0);
                    }
                    Opened::Ok(rw0) => {
                        var rw = rw0;
                        var rec = (0, 0, 0, 0 - 1, 0 - 1);
                        var v = (0, 0, 0, 0, 0);
                        var locked = false;
                        borrow mut rw as &!h in {
                            match file_lock(h) {
                                Done::Ok(n) => {
                                    locked = true;
                                }
                                Done::Failed(e2) => {
                                    locked = false;
                                }
                            }
                            if locked {
                                match file_size(h) {
                                    Done::Ok(size) => {
                                        v = trail.verify(h, size, window, max_log_len(), head, 0, "");
                                        let tail = size - v.1;
                                        if v.0 == trail.clean() || v.0 == trail.torn() && tail < max_log_len() + 4 {
                                            rec = log.recover(h, window, max_log_len());
                                            if rec.2 != v.2 {
                                                v = (9, 0, 0, 0, 0);
                                            }
                                        } else {
                                            v = (9, 0, 0, 0, 0);
                                            rec = (1, 0, 0, 0 - 1, 0 - 1);
                                        }
                                    }
                                    Done::Failed(e2) => {
                                        rec = (1, 0, 0, 0 - 1, 0 - 1);
                                        v = (9, 0, 0, 0, 0);
                                    }
                                }
                            }
                        }
                        if !locked {
                            status = refuse(io, -330);
                            file_close(w0);
                        } else if rec.0 != 0 || v.0 == 9 {
                            status = refuse(io, -331);
                            file_close(w0);
                        } else {
                            match open_read(fs, path) {
                                Opened::Failed(e2) => {
                                    status = refuse(io, -332);
                                    file_close(w0);
                                }
                                Opened::Ok(rd) => {
                                    var lg = log.attach(w0, rd, rec.1, rec.2, rec.3, rec.4, max_log_len());
                                    borrow mut lg as &!l in {
                                        status = core(fs, clock, io, heap, a, b, l, head, tape, resp, wire, req, ints, bytes_, config, env, raw, tx_hash, calldata, st, nb);
                                    }
                                    log.close(lg);
                                }
                            }
                        }
                        file_close(rw);
                    }
                }
            }
        }
    }
    return status;
}

// The request path of provider `which` (an optional file `target_a` or `target_b`, one line of at most 255 bytes: `/` and then letters, digits and `/._~%-`) into `nb`, its length in `nb[nb_target_len() + which]`. 0, or -333.
// A provider whose RPC key is in its path keeps it in this file, so the executor holds that credential (design 21.2 D8): read-only access to a provider, never a key that signs.
fn read_target[&c, &n](fs: &c Fs("/var/lib/cancho-executor"), which: int, nb: &!n [byte]) -> [fs_read("/var/lib/cancho-executor"), file_read] int {
    var path = "/var/lib/cancho-executor/target_a";
    if which == 1 {
        path = "/var/lib/cancho-executor/target_b";
    }
    let at = nb_target() + 256 * which;
    let got = read_small(fs, path, nb[at..at + 256]);
    if got == -1 {
        nb[nb_target_len() + which] = byte_of(0);
        return 0;
    }
    var end = got;
    if end > 0 && int_of(nb[at + end - 1]) == 10 {
        end = end - 1;
    }
    if got < 0 || end < 1 || end > 255 || int_of(nb[at]) != 47 {
        return -340;
    }
    var i = 0;
    while i < end {
        let c = int_of(nb[at + i]);
        if !(c >= 97 && c <= 122 || c >= 65 && c <= 90 || c >= 48 && c <= 57 || c == 47 || c == 46 || c == 95 || c == 126 || c == 37 || c == 45) {
            return -340;
        }
        i = i + 1;
    }
    nb[nb_target_len() + which] = byte_of(end);
    return 0;
}

// Does the text hold a PEM certificate's first line?
fn has_pem[&t](text: &t [byte]) -> [] bool {
    let lit = "-----BEGIN CERTIFICATE-----";
    var i = 0;
    while i + len(lit) <= len(text) {
        var k = 0;
        while k < len(lit) && int_of(text[i + k]) == int_of(lit[k]) {
            k = k + 1;
        }
        if k == len(lit) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// The network area (design 21.2): each provider's path, and, if one is `https`, the tick's entropy and the PEM roots. 0, -340 (a bad `target_*`) or -339 (no roots, or no entropy).
fn fill_net[&c, &u, &n](fs: &c Fs("/var/lib/cancho-executor"), ur: &u Fs("/dev/urandom"), nb: &!n [byte]) -> [fs_read("/var/lib/cancho-executor"), fs_read("/dev/urandom"), file_read] int {
    var code = read_target(fs, 0, nb);
    if code == 0 {
        code = read_target(fs, 1, nb);
    }
    if code != 0 {
        return code;
    }
    if secure_a() == 1 || secure_b() == 1 {
        region g {
            let e = alloc_slice[g](32, byte_of(0));
            if fs_read(ur, "/dev/urandom", e) != 32 {
                return -339;
            }
            var i = 0;
            while i < 32 {
                nb[nb_seed() + i] = e[i];
                i = i + 1;
            }
        }
        let rl = read_small(fs, "/var/lib/cancho-executor/roots.pem", nb[nb_roots()..nb_roots() + nb_roots_max()]);
        if rl < 1 || !has_pem(nb[nb_roots()..nb_roots() + rl]) {
            return -339;
        }
        var q = 0;
        while q < 4 {
            nb[nb_roots_len() + q] = byte_of(rl >> 8 * (3 - q) & 255);
            q = q + 1;
        }
    }
    return 0;
}

// Reads the job (the configuration, the envelope and the signed transaction), checks that what is to be sent is what was authorised, and goes on.
fn with_job[&c, &ur, &k, &i, &q, &oa, &ob, &t, &r, &w, &rq, &f, &x, &s, &nbx](fs: &c Fs("/var/lib/cancho-executor"), ur: &ur Fs("/dev/urandom"), clock: &k Clock, io: &!i Io, heap: &!q Heap, a: &oa Out("127.0.0.1:18545"), b: &ob Out("127.0.0.1:18546"), tape: &!t [int], resp: &!r [byte], wire: &!w [byte], req: &!rq [byte], ints: &!f [int], bytes_: &!x [byte], st: &!s [int], nb: &!nbx [byte]) -> [fs_read("/var/lib/cancho-executor"), fs_read("/dev/urandom"), fs_write("/var/lib/cancho-executor"), file_read, file_write, heap, net_out("127.0.0.1:18545"), net_out("127.0.0.1:18546"), poll, clock, io_write, conn_read, conn_write] int {
    var status = 2;
    region r {
        let config = alloc_slice[r](4, 0);
        let conf_text = alloc_slice[r](256, byte_of(0));
        let env_text = alloc_slice[r](700, byte_of(0));
        let env = alloc_slice[r](330, byte_of(0));
        let raw_text = alloc_slice[r](8300, byte_of(0));
        let raw = alloc_slice[r](4100, byte_of(0));
        let tx_hash = alloc_slice[r](32, byte_of(0));
        let calldata = alloc_slice[r](68, byte_of(0));
        let cn = read_small(fs, "/var/lib/cancho-executor/config", conf_text);
        if cn <= 0 || executor.parse_config(conf_text[0..cn], config) != 0 {
            return refuse(io, -333);
        }
        let en = read_hex_file(fs, "/var/lib/cancho-executor/envelope", env_text, env);
        var ok = en >= 263 && en <= 326 && int_of(env[0]) == 1;
        if ok {
            let calln = int_of(env[261]);
            ok = calln >= 1 && calln <= 64 && en == 262 + calln && be8(env, 97) == config[0];
        }
        let rn = read_hex_file(fs, "/var/lib/cancho-executor/raw", raw_text, raw);
        if !ok || rn < 1 {
            return refuse(io, -334);
        }
        if txcheck.validate_signed(raw[0..rn], be8(env, 97), be8(env, 197), env[125..145], env[145..165], env[165..197], env[205..237], be8(env, 237)) != 0 {
            return refuse(io, -334);
        }
        if keccak.hash256(st, raw[0..rn], tx_hash) != 0 || erc20.transfer_calldata(env[145..165], env[165..197], calldata) < 0 {
            return refuse(io, -334);
        }
        let netcode = fill_net(fs, ur, nb);
        if netcode != 0 {
            return refuse(io, netcode);
        }
        status = with_evidence(fs, clock, io, heap, a, b, tape, resp, wire, req, ints, bytes_, config, env[0..en], raw[0..rn], tx_hash, calldata, st, nb);
    }
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, out, ports, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(args);
    release(ports);
    release(signals);
    release(exec);
    release(tty);
    var status = 2;
    var console = io;
    var pool = heap;
    let (dir, urandom) = narrow(fs, "/var/lib/cancho-executor", "/dev/urandom");
    let (pa, pb) = narrow(out, "127.0.0.1:18545", "127.0.0.1:18546");
    borrow mut pool as &!hp in {
        let tape = box_slice(hp, 3 * 70000, 0);
        let resp = box_slice(hp, 80000, byte_of(0));
        let wire = box_slice(hp, 10000, byte_of(0));
        let req = box_slice(hp, 9000, byte_of(0));
        let ints = box_slice(hp, 16, 0);
        let bytes_ = box_slice(hp, 128, byte_of(0));
        let nbox = box_slice(hp, nb_len(), byte_of(0));
        let st = box_slice(hp, keccak.state_len(), 0);
        borrow mut tape as &!t1 in {
            borrow mut resp as &!r1 in {
                borrow mut wire as &!w1 in {
                    borrow mut req as &!q1 in {
                        borrow mut ints as &!f1 in {
                            borrow mut bytes_ as &!x1 in {
                                borrow mut st as &!s1 in {
                                    borrow mut nbox as &!n1 in {
                                        borrow urandom as &u1 in {
                                            borrow dir as &c1 in {
                                                borrow clock as &k1 in {
                                                    borrow pa as &a1 in {
                                                        borrow pb as &b1 in {
                                                            borrow mut console as &!i1 in {
                                                                status = with_job(c1, u1, k1, i1, hp, a1, b1, contents(t1), contents(r1), contents(w1), contents(q1), contents(f1), contents(x1), contents(s1), contents(n1));
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        unbox_slice(hp, nbox);
        unbox_slice(hp, tape);
        unbox_slice(hp, resp);
        unbox_slice(hp, wire);
        unbox_slice(hp, req);
        unbox_slice(hp, ints);
        unbox_slice(hp, bytes_);
        unbox_slice(hp, st);
    }
    release(pool);
    release(dir);
    release(urandom);
    release(pa);
    release(pb);
    release(clock);
    release(console);
    return status;
}
